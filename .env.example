# ─────────────────────────────────────────────────────────────────────────────
# Culina configuration. Copy to .env and fill in.
#
# These are bootstrap settings: they are needed before the database can be
# reached, so they come from the environment. Everything an admin can change
# while the app runs lives in the database instead and is edited in the app's
# own settings screens.
#
# The process refuses to start if any required value is missing or invalid — a
# misconfigured deployment fails loudly rather than on the first request that
# needed the value.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# The dev container publishes 5433, not 5432, so it cannot collide with a
# PostgreSQL already running on the host. Inside the container it is 5432.
# Configured as parts, never as one connection string, so each part can be
# validated and the password can be sourced separately.
Database__Host=localhost
Database__Port=5433
Database__Name=culina
Database__Username=culina_app
Database__Password=culina_dev_password
# Leave true in production. Only a local, non-TLS PostgreSQL justifies false.
Database__RequireSsl=false

# Superuser credentials for the local development container only. The
# application never uses these.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=culina
POSTGRES_PORT=5433

# ── Storage ──────────────────────────────────────────────────────────────────
# Both paths MUST be on persisted volumes.
#   ImagePath              losing it loses every recipe photo on redeploy.
#   DataProtectionKeyPath  losing it invalidates every session cookie on
#                          restart, silently signing everyone out.
Storage__ImagePath=./data/images
Storage__DataProtectionKeyPath=./data/keys

# ── Cookies ──────────────────────────────────────────────────────────────────
# Secure=false is for local HTTP development only. With it true, the
# __Host- cookie prefix requires HTTPS and login will not work over http://.
Cookies__Secure=false

# ── Reverse proxy ────────────────────────────────────────────────────────────
# Whose X-Forwarded-* headers are trusted. One of these is required in
# production: without it the app sees the proxy's address as every client's,
# which breaks per-IP rate limiting and makes every security log line name the
# wrong host. Trusting everything is worse — then any client can forge its own.
#
# Comma-separated addresses:
ForwardedHeaders__KnownProxies=
# Or networks in CIDR form, for a proxy in a container network whose address
# nobody can know in advance. `docker network inspect` gives you the subnet;
# keep it as small as it can be.
ForwardedHeaders__KnownNetworks=

# ── Password hashing (Argon2id) ──────────────────────────────────────────────
# Raise MemoryKib as far as the host tolerates. Existing hashes keep verifying
# and are transparently upgraded on the next successful login.
PasswordHashing__MemoryKib=65536
PasswordHashing__Iterations=3
PasswordHashing__Parallelism=2

# ── Telemetry ────────────────────────────────────────────────────────────────
# Unset means: log to stdout, export nothing. Culina invents no telemetry
# configuration names of its own — these are the standard OTEL_* variables.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=culina-api

# ── Public origin ────────────────────────────────────────────────────────────
# Used to template the absolute Sitemap: URL and security.txt canonical link.
PUBLIC_ORIGIN=http://localhost:5173
