# ─────────────────────────────────────────────────────────────────────────────
# Culina configuration. Copy to .env and fill in.
#
# Production needs two values from you, and compose.prod.yaml refuses to start
# without them: Database__Password and POSTGRES_SUPERUSER_PASSWORD. Development
# (`make dev`) needs neither — left empty, compose.yaml falls back to
# development-only passwords.
#
# Everything else here is safe to copy into production as it is. Docker Compose
# reads this file to fill in the compose files; the app sees only what they
# pass on to it.
#
# These are bootstrap settings: they are needed before the database can be
# reached, so they come from the environment. Everything an admin can change
# while the app runs lives in the database instead and is edited in the app's
# own settings screens.
#
# The process refuses to start if any required value is missing or invalid — a
# misconfigured deployment fails loudly rather than on the first request that
# needed the value.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# The role the database container creates for the app on its first start, and
# so the role and password the setup screen asks for. Where the database is,
# the compose file says.
#
# Production: a long random password. Development: leave it empty for
# culina_dev_password, which appsettings.Development.json signs in with.
Database__Username=culina_app
Database__Password=

# The PostgreSQL superuser. The app never uses it, which is no reason for it to
# be guessable: the setup screen and Settings → Server accept any role, and
# postgres/postgres there would run the app as superuser.
#
# Production: a long random password, not the one above. Development: leave it
# empty for postgres. Either way it is read once, when the database volume is
# first created.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_DB=culina

# Development only: the host port the database container is published on —
# 5433, not 5432, so it cannot collide with a PostgreSQL already running on the
# host. compose.prod.yaml publishes no port at all.
POSTGRES_PORT=5433

# ── Storage ──────────────────────────────────────────────────────────────────
# Both paths MUST be on persisted volumes.
#   ImagePath              losing it loses every recipe photo on redeploy.
#   DataProtectionKeyPath  losing it invalidates every session cookie on
#                          restart, silently signing everyone out.
Storage__ImagePath=./data/images
Storage__DataProtectionKeyPath=./data/keys

# ── Cookies ──────────────────────────────────────────────────────────────────
# Secure by default, which is right behind a proxy that terminates TLS. With it
# on, the session cookie takes the __Host- prefix and the browser sends it only
# over https:// (and to localhost). Leave it unset; `make dev` turns it off in
# appsettings.Development.json, not here.
#Cookies__Secure=true

# A session lapses after this many days without activity, and any request
# more than RenewAfterHours old extends it — so a device in daily use is
# never signed out, and one left alone for a month is.
#Cookies__SessionDays=30
#Cookies__RenewAfterHours=24

# ── Reverse proxy ────────────────────────────────────────────────────────────
# Whose X-Forwarded-* headers are trusted. One of these is required in
# production: without it the app sees the proxy's address as every client's,
# which breaks per-IP rate limiting and makes every security log line name the
# wrong host. Trusting everything is worse — then any client can forge its own.
#
# Comma-separated addresses:
ForwardedHeaders__KnownProxies=
# Or networks in CIDR form, for a proxy in a container network whose address
# nobody can know in advance. `docker network inspect` gives you the subnet;
# keep it as small as it can be.
ForwardedHeaders__KnownNetworks=

# ── Password hashing (Argon2id) ──────────────────────────────────────────────
# Raise MemoryKib as far as the host tolerates. Existing hashes keep verifying
# and are transparently upgraded on the next successful login.
PasswordHashing__MemoryKib=65536
PasswordHashing__Iterations=3
PasswordHashing__Parallelism=2

# ── Telemetry ────────────────────────────────────────────────────────────────
# Unset means: log to stdout, export nothing. Culina invents no telemetry
# configuration names of its own — these are the standard OTEL_* variables.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=culina-api

# ── Public origin ────────────────────────────────────────────────────────────
# Used to template the absolute Sitemap: URL and security.txt canonical link.
PUBLIC_ORIGIN=http://localhost:5173

# ── Importing from other apps ────────────────────────────────────────────────
# How many requests an hour one caller may make against a connected recipe
# library — reading its list and bringing recipes over. Separate from the
# paste-a-link import's own hard limit, and generous, because the risk is
# different in kind: a connected source is one fixed address a member of the
# household set up with a credential, not an address a caller picks per
# request. It has to be generous to be correct: recipes travel five to a
# request, so a library of five thousand is fifty reads and a thousand batches.
#RateLimits__SourceRequestsPerHour=1500
#
# Whether a connected recipe library (a Tandoor instance, and later others) may
# live on a private network. Off by default, because the safe answer has to be
# the one you get by not thinking about it.
#
# Turn it on when your recipe app runs on the same machine or the same LAN as
# this one, which is the common case for a self-hosted pair. It is the one
# thing that lets the server open a connection off the public internet, so it
# is a deployment decision rather than a screen any admin can flip.
#
# It never applies to the paste-a-link import: that address comes from a text
# box anyone with an account can type into, and it refuses private addresses
# whatever this says.
#Import__AllowPrivateSourceAddresses=true
