{
  "name": "culina-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node --experimental-strip-types build-tools/addRoutePreloads.ts && node --experimental-strip-types build-tools/compressBuild.ts",
    "build:native": "CULINA_TARGET=native vite build && node --experimental-strip-types build-tools/addRoutePreloads.ts build-native && node --experimental-strip-types build-tools/finishNativeShell.ts build-native",
    "native:sync": "pnpm build:native && cap sync",
    "native:ios": "pnpm native:sync && cap open ios",
    "native:android": "pnpm native:sync && cap open android",
    "native:run:ios": "pnpm native:sync && cap run ios",
    "native:run:android": "pnpm native:sync && cap run android",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && pnpm messages || echo \"\"",
    "check": "pnpm messages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "generate:api": "openapi-typescript ../backend/openapi/Api.json --output src/lib/api/generated/schema.d.ts",
    "icons": "node --experimental-strip-types build-tools/generateIcons.ts",
    "test:unit": "pnpm messages && vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "messages": "node --experimental-strip-types build-tools/compileMessages.ts",
    "verify:release": "node --experimental-strip-types build-tools/checkRelease.ts",
    "verify:budget": "node --experimental-strip-types build-tools/checkBudget.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.27.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@vitest/browser": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "openapi-fetch": "^0.17.0"
  },
  "packageManager": "pnpm@11.28.5"
}
