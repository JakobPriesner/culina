{
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["build-tools/**/*.ts"]
}
