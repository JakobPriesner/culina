  "components": {
    "schemas": {
      "HouseholdsChangeMemberRoleRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "`owner` or `member`."
          }
        },
        "description": "The role to give a member."
      },
      "HouseholdsChangeMemberRoleResponse": {
        "required": [
          "member",
          "version"
        ],
        "type": "object",
        "properties": {
          "member": {
            "$ref": "#/components/schemas/HouseholdsMember"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "The household's new version.",
            "format": "int64"
          }
        },
        "description": "The member after the change."
      },
      "HouseholdsCreateRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "What to call it."
          }
        },
        "description": "A new household."
      },
      "HouseholdsCreateResponse": {
        "required": [
          "householdId",
          "name",
          "memberCount",
          "yourRole",
          "version"
        ],
        "type": "object",
        "properties": {
          "householdId": {
            "type": "string",
            "description": "The household's id.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "What it is called."
          },
          "memberCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "How many people are in it.",
            "format": "int32"
          },
          "yourRole": {
            "type": "string",
            "description": "What the caller may do in it."
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "The entity version, for If-Match on an update.",
            "format": "int64"
          }
        },
        "description": "The household that was created."
