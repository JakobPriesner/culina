{
  "openapi": "3.0.4",
  "info": {
    "title": "Culina API",
    "description": "Culina's HTTP API. Every failure is an RFC 9457 problem document with a machine-readable `code` and a `requestId`; clients branch on `code`, never on a message.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create an account",
        "description": "Creates an account. The first account on an instance always succeeds and becomes the administrator, with a household of its own; afterwards the instance's registration settings decide.",
        "operationId": "registerUserV1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsersRegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersRegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "UsersRegisterRequest": {
        "required": [
          "email",
          "displayName",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The address they will sign in with."
          },
          "displayName": {
            "type": "string",
            "description": "What they want to be called."
          },
          "password": {
            "type": "string",
            "description": "Their chosen password, at least 12 characters."
          },
          "householdName": {
            "type": "string",
            "description": "What to call the household created alongside the first account on an\ninstance. Ignored otherwise.",
            "nullable": true
          }
        },
        "description": "What a new account needs."
      },
      "UsersRegisterResponse": {
        "required": [
          "userId",
          "email",
          "displayName",
          "isAdmin"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "The new user's id.",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "The address they sign in with, normalised."
          },
          "displayName": {
            "type": "string",
            "description": "What they are called."
          },
          "isAdmin": {
            "type": "boolean",
            "description": "Whether this account administers the instance."
          },
          "householdId": {
            "type": "string",
            "description": "The household created with the account, when one was. Null means the\nclient should offer to create one or redeem an invitation.",
            "format": "uuid",
            "nullable": true
          }
        },
        "description": "The account that was created."
      }
    }
  },
  "tags": [
    {
      "name": "Users"
    }
  ]
}