<Project Sdk="Microsoft.NET.Sdk">

  <!-- Adapters: persistence, identity, image storage, settings stores. -->
  <ItemGroup>
    <!-- Infrastructure types are internal by convention (sessions, executors,
         repositories), so the project that tests them has to see them. -->
    <InternalsVisibleTo Include="IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Application/Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Google.GenAI" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
  </ItemGroup>

  <!-- Migrations are embedded so the runner needs no files on disk. -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/*.sql" />
  </ItemGroup>

</Project>
