<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup Label="Application">
        <!-- Abstractions only: Application declares ports and logs, and must not reach a concrete host or container. -->
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup Label="Relay">
        <!-- The push relay's one table (relay token hash to device), in a file beside it: no database server to run for a map. -->
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup Label="Infrastructure">
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
        <!-- The admin's saved server settings are one more configuration source, read by the same provider as appsettings.json. -->
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
        <PackageVersion Include="Npgsql" Version="10.0.3" />
        <PackageVersion Include="Lib.Net.Http.WebPush" Version="3.3.1" />
        <PackageVersion Include="Dapper" Version="2.1.89" />
        <!-- Argon2id: memory-hard password hashing, per cookie-auth-and-security. -->
        <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
        <!-- Encrypts the model provider's API key before it is stored; the standalone package, because Infrastructure is a plain library and DataProtectionProvider.Create(DirectoryInfo) needs no host. -->
        <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.13" />
        <!-- Uploads are re-encoded, stripping EXIF (GPS in food photos leaks). MIT; ImageSharp 3.2+ and 4.x refuse a Release build without a paid licence key.
             The Linux build of the native library with no dependencies beyond glibc, so the chiseled runtime image needs no fontconfig. -->
        <PackageVersion Include="SkiaSharp" Version="4.153.1" />
        <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
        <!-- Optional image storage in an S3-compatible bucket; AWS's own client, which MinIO, Hetzner and R2 also speak. -->
        <PackageVersion Include="AWSSDK.S3" Version="4.0.104.3" />
        <!-- SMTP for the administrator's mail account; System.Net.Mail.SmtpClient is obsolete for new code (no modern auth, weak TLS handling). -->
        <PackageVersion Include="MailKit" Version="4.18.1" />
        <!-- Pinned above what MimeKit asks for (10.0.0), which has known advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
        <!-- The providers' own clients: a field renamed upstream used to bind to null and read as an unreadable answer. -->
        <PackageVersion Include="OpenAI" Version="2.14.0" />
        <PackageVersion Include="Google.GenAI" Version="1.25.0" />
        <PackageVersion Include="OllamaSharp" Version="5.5.0" />
        <!-- One shape for "ask a model for text"; OpenAI and Ollama offer an IChatClient, Google has none, so its adapter uses the SDK directly. -->
        <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
        <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    </ItemGroup>

    <ItemGroup Label="Api">
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
        <!-- Emits the OpenAPI document at build time, so the frontend client is
             generated from a committed file and never from a running server. -->
        <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
        <!-- The machine a signal came from and what it was using. Only ever
             published as pre-releases; pinned to the SDK's own release. -->
        <PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.19.0-rc.1" />
        <PackageVersion Include="OpenTelemetry.Resources.Container" Version="1.19.1-beta.1" />
        <PackageVersion Include="OpenTelemetry.Resources.Host" Version="1.19.1-beta.1" />
        <PackageVersion Include="OpenTelemetry.Resources.OperatingSystem" Version="1.19.1-beta.1" />
        <PackageVersion Include="OpenTelemetry.Resources.Process" Version="1.19.1-rc.1" />
        <PackageVersion Include="OpenTelemetry.Resources.ProcessRuntime" Version="1.19.1-beta.1" />
        <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
        <!-- The MCP server agents connect to (/api/mcp); the protocol's official C# SDK, maintained with Microsoft. -->
        <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    </ItemGroup>

    <ItemGroup Label="Tests">
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
        <!-- The assertion and extensibility types without the test host, for
             the shared TestSupport library, which holds helpers and no facts. -->
        <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
        <PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
        <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    </ItemGroup>

</Project>
