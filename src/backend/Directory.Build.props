<Project>

    <!-- Repo-wide MSBuild properties inherited by every csproj, each with the reason it is set. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Warnings are errors, so a clean compile is also a clean lint. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsAsErrors>Nullable</WarningsAsErrors>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>All</AnalysisMode>

        <!-- Applies the .editorconfig style rules during build, not only in the IDE. -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Deterministic>true</Deterministic>

        <!-- Package versions live once, in Directory.Packages.props; a csproj never carries
             `Version=`. -->
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

        <!-- Every restore writes a packages.lock.json and CI/the image restore in locked mode, so
             builds are reproducible; not applied to the solution file, which has no target
             framework. -->
        <RestorePackagesWithLockFile Condition="'$(MSBuildProjectExtension)' != '.slnx'">true</RestorePackagesWithLockFile>

        <!-- A vulnerable transitive package fails the compile rather than a later review. -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>

        <!-- Culina formats user-facing values on the client, where the locale lives; the server
             does culture-invariant work only. -->
        <InvariantGlobalization>true</InvariantGlobalization>

        <IsTestProject>false</IsTestProject>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>
