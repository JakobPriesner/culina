# Culina — one formatting source of truth for the whole repository.
# `dotnet format` and Prettier both read this file (Prettier via
# `editorconfig: true`), so formatting arguments are settled here and never in
# review. C# style rules are errors to match TreatWarningsAsErrors: a build
# that compiles is a build that is formatted.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{ts,js,mjs,cjs,svelte,json,jsonc,yml,yaml,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sln,slnx,csproj,props,targets}]
indent_size = 2

[Makefile]
indent_style = tab

[*.cs]
# ── Formatting is a build error, not a suggestion ──────────────────
dotnet_diagnostic.IDE0055.severity = error

# ── Language conventions ───────────────────────────────────────────
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:error
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_prefer_collection_expression = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
dotnet_style_readonly_field = true:error
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error

# ── Usings ─────────────────────────────────────────────────────────
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ── Newlines ───────────────────────────────────────────────────────
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# ── Naming ─────────────────────────────────────────────────────────
# Styles
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Constants and static readonly fields read as values, so PascalCase. Rules
# are evaluated in order, and these must precede the camelCase rule below.
dotnet_naming_rule.constants_pascal_case.severity = error
dotnet_naming_rule.constants_pascal_case.symbols = constants
dotnet_naming_rule.constants_pascal_case.style = pascal_case
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_readonly_pascal_case.severity = error
dotnet_naming_rule.static_readonly_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal_case.style = pascal_case
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

# Private instance state is camelCase with no underscore prefix.
dotnet_naming_rule.private_fields_camel_case.severity = error
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected

# ── Analyzer rules that do not apply to an application ─────────────
# AnalysisMode=All turns on every rule, including a family written for public
# cross-language NuGet libraries. Culina is a self-contained application: it
# has no external consumers, no VB or F# callers, and no binary compatibility
# obligations. Each of these is disabled for that reason, not to silence a real
# finding.
#
# CA1716: type/namespace names that collide with reserved words in other CLR
#         languages. `Error` and `Shared` are the right names here.
dotnet_diagnostic.CA1716.severity = none
# CA2225: demands a named twin for every operator. The implicit conversion from
#         Error exists so `return UserErrors.NotFound(id);` reads well, and the
#         named alternative (Result.Failure) already exists.
dotnet_diagnostic.CA2225.severity = none
# CA1000: static members on generic types. Result<T>.Success is the intended
#         construction API; a separate non-generic factory would be worse.
dotnet_diagnostic.CA1000.severity = none
# CA1815: value types must implement equality. Comparing two Results, or two
#         in-flight outcomes, is meaningless; types that *are* compared by
#         value are records, which get equality for free.
dotnet_diagnostic.CA1815.severity = none
# CA1034: nested public types. Used sparingly where a type is meaningless
#         outside its parent.
dotnet_diagnostic.CA1034.severity = none
# CA1724: type names that collide with a namespace name. DependencyInjection
#         is the name the conventions give each layer's registration class, and
#         a collision with Microsoft.Extensions.DependencyInjection only
#         inconveniences an external consumer importing both.
dotnet_diagnostic.CA1724.severity = none
# CA1054/CA1056: URL-shaped parameters and properties should be System.Uri.
#         They should not, here. A wire contract carries a URL as a string
#         because that is what JSON carries, and the one URL a user supplies is
#         untrusted text that may not parse as a Uri at all — turning it into
#         one is validation, and validation is the thing being asked for.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none
# CA1062: null-checking public arguments. Every public entry point already uses
#         ArgumentNullException.ThrowIfNull; the analyzer cannot see through the
#         helper and reports false positives.
dotnet_diagnostic.CA1062.severity = none

# ── Analyzer noise that fights this repo's conventions ─────────────
# CA1812: internal classes are instantiated by the DI container, which the
#         analyzer cannot see. Registration is explicit and covered by an
#         architecture test instead.
dotnet_diagnostic.CA1812.severity = none
# CA1848: LoggerMessage source generation is already mandatory here
#         (dotnet-observability); the analyzer also flags the generated code.
dotnet_diagnostic.CA1848.severity = none

[**/tests/**/*.cs]
# Test methods are named Method_ShouldX_WhenY, which is deliberately not a
# valid identifier style for the production naming rules.
dotnet_diagnostic.CA1707.severity = none
# Test classes must be public for the runner to discover them.
dotnet_diagnostic.CA1515.severity = none
# Fakes and builders are instantiated by tests, not by a container.
dotnet_diagnostic.CA1812.severity = none
# ConfigureAwait(false) matters where a synchronization context might exist.
# The xUnit v3 runner has none, so requiring it in tests adds noise to every
# await without changing behaviour.
dotnet_diagnostic.CA2007.severity = none
# CA2000: tests routinely build a disposable through a small factory method and
# `await using` it at the call site. The analyzer cannot follow ownership across
# that boundary and reports every such helper.
dotnet_diagnostic.CA2000.severity = none
