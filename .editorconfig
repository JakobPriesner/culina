# Culina — one formatting source of truth for the whole repository.
# `dotnet format` and Prettier both read this file (Prettier via
# `editorconfig: true`), so formatting arguments are settled here and never in
# review. C# style rules are errors to match TreatWarningsAsErrors: a build
# that compiles is a build that is formatted.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{ts,js,mjs,cjs,svelte,json,jsonc,yml,yaml,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sln,slnx,csproj,props,targets}]
indent_size = 2

[Makefile]
indent_style = tab

[*.cs]
# ── Formatting is a build error, not a suggestion ──────────────────
dotnet_diagnostic.IDE0055.severity = error

# ── Language conventions ───────────────────────────────────────────
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:error
dotnet_style_require_accessibility_modifiers = always:error
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_prefer_collection_expression = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
dotnet_style_readonly_field = true:error
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error

# ── Usings ─────────────────────────────────────────────────────────
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ── Newlines ───────────────────────────────────────────────────────
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# ── Naming ─────────────────────────────────────────────────────────
# Styles
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Constants and static readonly fields read as values, so PascalCase. Rules
# are evaluated in order, and these must precede the camelCase rule below.
dotnet_naming_rule.constants_pascal_case.severity = error
dotnet_naming_rule.constants_pascal_case.symbols = constants
dotnet_naming_rule.constants_pascal_case.style = pascal_case
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_readonly_pascal_case.severity = error
dotnet_naming_rule.static_readonly_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal_case.style = pascal_case
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

# Private instance state is camelCase with no underscore prefix.
dotnet_naming_rule.private_fields_camel_case.severity = error
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected

# ── Analyzer noise that fights this repo's conventions ─────────────
# CA1812: internal classes are instantiated by the DI container, which the
#         analyzer cannot see. Registration is explicit and covered by an
#         architecture test instead.
dotnet_diagnostic.CA1812.severity = none
# CA1848: LoggerMessage source generation is already mandatory here
#         (dotnet-observability); the analyzer also flags the generated code.
dotnet_diagnostic.CA1848.severity = none

[**/tests/**/*.cs]
# Test methods are named Method_ShouldX_WhenY, which is deliberately not a
# valid identifier style for the production naming rules.
dotnet_diagnostic.CA1707.severity = none
# Test classes must be public for the runner to discover them.
dotnet_diagnostic.CA1515.severity = none
# Fakes and builders are instantiated by tests, not by a container.
dotnet_diagnostic.CA1812.severity = none
