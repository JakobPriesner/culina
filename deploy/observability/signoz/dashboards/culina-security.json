{
  "schemaVersion": "v6",
  "name": "culina-security",
  "tags": [
    {
      "key": "app",
      "value": "culina"
    }
  ],
  "spec": {
    "display": {
      "name": "Culina · Security",
      "description": "Refused sign-ins and recovery codes, and requests turned away by the CSRF, origin and rate-limit checks."
    },
    "duration": "6h",
    "refreshInterval": "0s",
    "variables": [],
    "panels": {
      "sec-login-total": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Refused sign-ins",
            "description": "In the selected range."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "culina.auth.login_failures",
                        "temporality": "cumulative",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = '${CULINA_API_SERVICE}'"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "sec-recovery-total": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Refused recovery codes",
            "description": "In the selected range."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "culina.auth.recovery_failures",
                        "temporality": "cumulative",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = '${CULINA_API_SERVICE}'"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "sec-ratelimit-total": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Rate-limited requests",
            "description": "In the selected range."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "culina.ratelimit.rejections",
                        "temporality": "cumulative",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = '${CULINA_API_SERVICE}'"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "sec-csrf-origin-total": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CSRF and origin refusals",
            "description": "In the selected range."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "culina.csrf.rejections",
                              "temporality": "cumulative",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum",
                              "reduceTo": "sum"
                            }
                          ],
                          "filter": {
                            "expression": "service.name = '${CULINA_API_SERVICE}'"
                          },
                          "disabled": true
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "culina.origin.rejections",
                              "temporality": "cumulative",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum",
                              "reduceTo": "sum"
                            }
                          ],
                          "filter": {
                            "expression": "service.name = '${CULINA_API_SERVICE}'"
                          },
                          "disabled": true
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "name": "F1",
                          "expression": "A + B",
                          "legend": "refused"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "sec-auth": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Refused sign-ins and recovery codes",
            "description": "Alerts: sign-ins warning above 20 and critical above 100 in 5 minutes; recovery codes above 5 and 20 in 15 minutes."
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              },
              "thresholds": [],
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "culina.auth.login_failures",
                              "temporality": "cumulative",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum"
                            }
                          ],
                          "filter": {
                            "expression": "service.name = '${CULINA_API_SERVICE}'"
                          },
                          "legend": "sign-in"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "culina.auth.recovery_failures",
                              "temporality": "cumulative",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum"
                            }
                          ],
                          "filter": {
                            "expression": "service.name = '${CULINA_API_SERVICE}'"
                          },
                          "legend": "recovery code"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "sec-rejections": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Refused requests",
            "description": "CSRF, origin and rate-limit refusals per interval."
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              },
              "thresholds": [],
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "culina.csrf.rejections",
                              "temporality": "cumulative",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum"
                            }
                          ],
                          "filter": {
                            "expression": "service.name = '${CULINA_API_SERVICE}'"
                          },
                          "legend": "CSRF"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "culina.origin.rejections",
                              "temporality": "cumulative",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum"
                            }
                          ],
                          "filter": {
                            "expression": "service.name = '${CULINA_API_SERVICE}'"
                          },
                          "legend": "origin"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "C",
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "culina.ratelimit.rejections",
                              "temporality": "cumulative",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum"
                            }
                          ],
                          "filter": {
                            "expression": "service.name = '${CULINA_API_SERVICE}'"
                          },
                          "legend": "rate limit"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "sec-reasons": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Refusals by reason",
            "description": "Event 1801 lines grouped by the reason given."
          },
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "formatting": {
                "columnUnits": {
                  "A": "short"
                },
                "decimalPrecision": "2"
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "logs",
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = '${CULINA_API_SERVICE}' AND attribute.logrecord.event.id = 1801"
                    },
                    "groupBy": [
                      {
                        "name": "Reason"
                      }
                    ],
                    "order": [
                      {
                        "key": {
                          "name": "count()"
                        },
                        "direction": "desc"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "sec-addresses": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Addresses behind refusals",
            "description": "Events 1001-1003 and 1801 by client address: candidates for a ban at the proxy."
          },
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "formatting": {
                "columnUnits": {
                  "A": "short"
                },
                "decimalPrecision": "2"
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "logs",
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = '${CULINA_API_SERVICE}' AND attribute.logrecord.event.id IN (1001, 1002, 1003, 1801)"
                    },
                    "groupBy": [
                      {
                        "name": "ClientAddress"
                      }
                    ],
                    "order": [
                      {
                        "key": {
                          "name": "count()"
                        },
                        "direction": "desc"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "sec-log": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Latest refusals",
            "description": "The latest refused sign-ins, recovery codes and rejected requests."
          },
          "plugin": {
            "kind": "signoz/ListPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "raw",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "logs",
                    "filter": {
                      "expression": "service.name = '${CULINA_API_SERVICE}' AND attribute.logrecord.event.id IN (1001, 1002, 1003, 1801)"
                    },
                    "order": [
                      {
                        "key": {
                          "name": "timestamp"
                        },
                        "direction": "desc"
                      }
                    ],
                    "limit": 50
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "At a glance"
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/sec-login-total"
              }
            },
            {
              "x": 3,
              "y": 0,
              "width": 3,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/sec-recovery-total"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 3,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/sec-ratelimit-total"
              }
            },
            {
              "x": 9,
              "y": 0,
              "width": 3,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/sec-csrf-origin-total"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Over time"
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/sec-auth"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/sec-rejections"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Who"
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/sec-reasons"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/sec-addresses"
              }
            },
            {
              "x": 0,
              "y": 7,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/sec-log"
              }
            }
          ]
        }
      }
    ]
  }
}
