{
  "alert": "Culina: AI provider refusing calls",
  "alertType": "LOGS_BASED_ALERT",
  "labels": {
    "area": "assistant",
    "service": "${CULINA_API_SERVICE}"
  },
  "annotations": {
    "summary": "{{$value}} AI provider calls failed in 15 minutes (threshold {{$threshold}})",
    "description": "Event 1501 carries the provider's own reason: an expired key, exhausted credit, a retired model, or throttling. Fix it under Settings, Assistant. docs/operations.md, section Alerts."
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m",
      "frequency": "1m"
    }
  },
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "logs",
            "stepInterval": "1m",
            "aggregations": [
              {
                "expression": "count()"
              }
            ],
            "filter": {
              "expression": "service.name = '${CULINA_API_SERVICE}' AND attribute.logrecord.event.id = 1501"
            }
          }
        }
      ]
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 19,
          "op": "above",
          "matchType": "in_total"
        },
        {
          "name": "warning",
          "target": 2,
          "op": "above",
          "matchType": "in_total"
        }
      ]
    }
  }
}
