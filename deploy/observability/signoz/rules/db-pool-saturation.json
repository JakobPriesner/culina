{
  "alert": "Culina: database pool nearly exhausted",
  "alertType": "METRIC_BASED_ALERT",
  "labels": {
    "area": "database",
    "service": "${CULINA_API_SERVICE}"
  },
  "annotations": {
    "summary": "{{$value}}% of database connections in use (threshold {{$threshold}}%)",
    "description": "Requests are about to queue for a connection. Event 1971 names the use case holding connections longest; Database__MaxPoolSize raises the ceiling within PostgreSQL's max_connections. docs/operations.md, section Alerts."
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m",
      "frequency": "1m"
    }
  },
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "metrics",
            "stepInterval": "1m",
            "aggregations": [
              {
                "metricName": "db.client.connection.count",
                "temporality": "cumulative",
                "timeAggregation": "avg",
                "spaceAggregation": "max"
              }
            ],
            "filter": {
              "expression": "service.name = '${CULINA_API_SERVICE}' AND db.client.connection.state = 'used'"
            },
            "groupBy": [
              {
                "name": "service.instance.id"
              }
            ]
          }
        },
        {
          "type": "builder_query",
          "spec": {
            "name": "B",
            "signal": "metrics",
            "stepInterval": "1m",
            "aggregations": [
              {
                "metricName": "db.client.connection.max",
                "temporality": "cumulative",
                "timeAggregation": "avg",
                "spaceAggregation": "max"
              }
            ],
            "filter": {
              "expression": "service.name = '${CULINA_API_SERVICE}'"
            },
            "groupBy": [
              {
                "name": "service.instance.id"
              }
            ]
          }
        },
        {
          "type": "builder_formula",
          "spec": {
            "name": "F1",
            "expression": "A / B * 100"
          }
        }
      ]
    },
    "selectedQueryName": "F1",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 95,
          "op": "above",
          "matchType": "all_the_times"
        },
        {
          "name": "warning",
          "target": 80,
          "op": "above",
          "matchType": "all_the_times"
        }
      ]
    }
  }
}
