{
  "alert": "Culina: API p95 latency",
  "alertType": "TRACES_BASED_ALERT",
  "labels": {
    "area": "performance",
    "service": "${CULINA_API_SERVICE}"
  },
  "annotations": {
    "summary": "API p95 latency {{$value}} (threshold {{$threshold}})",
    "description": "Requests have been slow for the whole window. Sort the related traces by duration: a long Npgsql span is the database (see the pool alerts), a long HttpClient span an import source or AI provider. Event streams (culina.stream) are left out: they stay open as long as someone watches. docs/operations.md, section Alerts."
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "10m",
      "frequency": "1m"
    }
  },
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "traces",
            "stepInterval": "1m",
            "aggregations": [
              {
                "expression": "p95(duration_nano)"
              }
            ],
            "filter": {
              "expression": "service.name = '${CULINA_API_SERVICE}' AND kind_string = 'Server' AND culina.stream NOT EXISTS"
            }
          }
        }
      ],
      "unit": "ns"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 3,
          "op": "above",
          "matchType": "all_the_times",
          "targetUnit": "s"
        },
        {
          "name": "warning",
          "target": 1,
          "op": "above",
          "matchType": "all_the_times",
          "targetUnit": "s"
        }
      ]
    }
  }
}
