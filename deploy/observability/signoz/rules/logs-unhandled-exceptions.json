{
  "alert": "Culina: unhandled exceptions",
  "alertType": "LOGS_BASED_ALERT",
  "labels": {
    "area": "errors",
    "service": "${CULINA_API_SERVICE}"
  },
  "annotations": {
    "summary": "{{$value}} error lines from the API in 10 minutes (threshold {{$threshold}})",
    "description": "Errors are defects, not expected failures (those are results). Event 1800 is an unhandled exception with its stack; the TraceId on the line is the request id the user was shown. docs/operations.md, section Alerts."
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "10m",
      "frequency": "1m"
    }
  },
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "logs",
            "stepInterval": "1m",
            "aggregations": [
              {
                "expression": "count()"
              }
            ],
            "filter": {
              "expression": "service.name = '${CULINA_API_SERVICE}' AND severity_number >= 17"
            }
          }
        }
      ]
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 10,
          "op": "above",
          "matchType": "in_total"
        },
        {
          "name": "warning",
          "target": 0,
          "op": "above",
          "matchType": "in_total"
        }
      ]
    }
  }
}
