{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "culina-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "watch",
        "--project",
        "src/backend/src/Api",
        "run",
        "--non-interactive"
      ],
      "port": 5000
    },
    {
      "name": "culina-api-setup",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ASPNETCORE_ENVIRONMENT=Production",
        "ASPNETCORE_URLS=http://localhost:5000",
        "Cookies__AllowInsecureOutsideDevelopment=true",
        "Storage__ImagePath=../../../../data/setup-preview/images",
        "Storage__DataProtectionKeyPath=../../../../data/setup-preview/keys",
        "Storage__ConfigPath=../../../../data/setup-preview/config",
        "dotnet",
        "run",
        "--project",
        "src/backend/src/Api",
        "--no-launch-profile"
      ],
      "port": 5000
    },
    {
      "name": "culina-frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "src/frontend",
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "culina-frontend-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "src/frontend",
        "dev",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "culina-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "src/frontend",
        "exec",
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "culina-api-5050",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ASPNETCORE_ENVIRONMENT=Development",
        "ASPNETCORE_URLS=http://localhost:5050",
        "dotnet",
        "watch",
        "--project",
        "src/backend/src/Api",
        "run",
        "--non-interactive",
        "--no-launch-profile"
      ],
      "port": 5050
    },
    {
      "name": "culina-frontend-5050",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CULINA_API=http://localhost:5050",
        "pnpm",
        "--dir",
        "src/frontend",
        "dev",
        "--port",
        "5176",
        "--strictPort"
      ],
      "port": 5176
    }
  ]
}
